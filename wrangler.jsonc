// Replace database_id with your own Cloudflare D1 database ID before remote deployment.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clinical-compass",
  "main": "server/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"clinical-compass-voice"}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clinical-compass",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
